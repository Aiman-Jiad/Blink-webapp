# Blink — Firebase configuration
#
# Copy this file to `.env` and fill in your Firebase project credentials.
# When these are NOT provided, Blink runs in demo mode using a
# localStorage-backed mock backend — no setup required.
#
# Get your credentials from:
#   https://console.firebase.google.com/ → Project Settings → General → SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
